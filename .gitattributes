# Auto-detect text files; enable Git's built-in text normalization
* text=auto

# =====================
# Java SDK source files
# =====================
*.java     text eol=lf
*.xml      text eol=lf
*.properties text eol=lf

# =====================
# Build & configuration
# =====================
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.toml     text eol=lf
*.env      text eol=lf
*.example  text eol=lf

# =====================
# Documentation
# =====================
*.md       text eol=lf
*.txt      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf

# =====================
# Python tooling
# =====================
*.py       text eol=lf

# =====================
# Others
# =====================
*.lock     text eol=lf
*.svg      text eol=lf

# =====================
# Binary files — never normalize
# =====================
*.jar      binary
*.class    binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.zip      binary
*.tar      binary
*.gz       binary