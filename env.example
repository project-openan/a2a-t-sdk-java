# Prompt runtime
# Controls the language used by prompt runtime components.
A2AT_LANGUAGE=en-US
# Selects the prompt source backend (classpath | local_file).
A2AT_PROMPT_SOURCE_TYPE=classpath
# Required when A2AT_PROMPT_SOURCE_TYPE=local_file (assembly-time fail-fast if
# unset or the path does not exist). Business content (templates/slots/scenarios
# of Task-T/Notification-T/Authorization-T) is loaded from this root with a
# local-first overlay: a missing resource falls back to the built-in classpath
# copy (each resource path warns once about the fallback). Negotiation resources
# and LLM prompts are always loaded from the classpath.
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=

# Prompt compliance
# Enables or disables prompt compliance checks.
A2AT_PROMPT_COMPLIANCE_ENABLED=false

# Input limits
# Maximum length in characters (String.length()) accepted for free-text inputs (FromText generation and
# prompt validation entry points) before they reach an LLM step; oversized inputs fail fast with the
# error code input.text_too_long instead of overflowing the LLM context.
A2AT_INPUT_TEXT_MAX_CHARS=16384

# LLM runtime
# Selects the LLM provider used by the shared client.
A2AT_LLM_PROVIDER=
# Selects the default model name for the configured provider.
A2AT_LLM_MODEL=
# API key for the configured LLM provider.
A2AT_LLM_API_KEY=
# Base URL for the configured LLM provider.
A2AT_LLM_BASE_URL=
# Optional maximum tokens for completion calls.
A2AT_LLM_MAX_TOKENS=2000
# Default sampling temperature.
A2AT_LLM_TEMPERATURE=0
# Request timeout in seconds.
A2AT_LLM_TIMEOUT_SECONDS=60
# Number of chat history messages to keep.
A2AT_LLM_HISTORY_WINDOW=10
# Reasoning effort level (none, minimal, low, medium, high, xhigh). Set to empty to skip.
A2AT_LLM_REASONING_EFFORT=
# Whether to bypass the system HTTP proxy for LLM calls.
A2AT_LLM_DISABLE_SYSTEM_PROXY=false
# Maximum total number of tracked sessions.
A2AT_LLM_SESSION_MAX_TOTAL=300
# Maximum number of tracked sessions per provider.
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100
# Maximum number of attempts for retryable LLM steps (range 1-10, default 3).
A2AT_LLM_MAX_ATTEMPTS=3

# Negotiation
# Selects the negotiation state store implementation.
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory
