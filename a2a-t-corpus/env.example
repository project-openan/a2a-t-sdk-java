# Corpus test LLM runtime
# Uses the same A2AT_LLM_* key names as the project-root env.example, so the corpus
# template is a tuned subset of the root one. Copy this file to .env and fill in the
# required entries; extra keys copied over from the root template are ignored.

# LLM runtime
# Selects the LLM provider used by the shared client. Only "openai" is supported.
A2AT_LLM_PROVIDER=openai
# Selects the default model name for the configured provider.
A2AT_LLM_MODEL=
# API key for the configured LLM provider.
A2AT_LLM_API_KEY=
# Base URL for the configured LLM provider.
A2AT_LLM_BASE_URL=
# Maximum number of completion tokens. Validation outputs can exceed 2k tokens and
# reasoning models may consume the budget with reasoning content; keep this ample.
A2AT_LLM_MAX_TOKENS=102400
# Default sampling temperature.
A2AT_LLM_TEMPERATURE=0
# Request timeout in seconds.
A2AT_LLM_TIMEOUT_SECONDS=300
# Maximum number of attempts for retryable LLM steps (range 1-10, default 3).
A2AT_LLM_MAX_ATTEMPTS=1