# Authorization-T demo environment.
# Copy to authz.env and fill A2AT_LLM_API_KEY to run the demo.
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=classpath
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=
A2AT_LLM_BASE_URL=
A2AT_LLM_API_KEY=
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory