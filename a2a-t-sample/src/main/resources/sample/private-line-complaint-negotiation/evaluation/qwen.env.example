# Copy this file to a local, ignored location in the target network before running the evaluation.
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=classpath
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=qwen3-32b
A2AT_LLM_BASE_URL=
A2AT_LLM_API_KEY=
A2AT_LLM_TEMPERATURE=0
A2AT_LLM_TIMEOUT_SECONDS=60
A2AT_LLM_DISABLE_SYSTEM_PROXY=true
A2AT_SAMPLE_HOST=127.0.0.1
A2AT_SAMPLE_PORT=8010
